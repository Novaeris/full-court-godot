{
	"mcpServers": {
		"godot": {
			"command": "npx",
			"args": [
				"-y",
				"@coding-solo/godot-mcp@0.1.1"
			],
			"env": {
				"GODOT_PATH": "${GODOT_PATH:-godot_console}"
			}
		},
		"blender": {
			"command": "uvx",
			"args": [
				"--from",
				"mcp-for-blender==2.3.1",
				"mcp-for-blender"
			]
		}
	}
}
