# Normalize line endings so Windows, Mac and CI all see the same files.
* text=auto

# Godot and data files: always LF in the repository and on checkout.
*.gd text eol=lf
*.uid text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.cfg text eol=lf
*.json text eol=lf
*.md text eol=lf
*.gitignore text eol=lf

# Windows scripts keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf

# Binary assets: never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ogg binary
*.wav binary
*.mp3 binary
*.ttf binary
*.otf binary

# Bundled starter content release: checksums cover exact bytes, so never convert line endings.
data/content_starter/** -text

# Blender source art (D-076): stored with Git LFS (large binaries, versioned backups).
*.blend filter=lfs diff=lfs merge=lfs -text
*.blend1 filter=lfs diff=lfs merge=lfs -text
