extends SceneTree
## Writes data/player_pipeline/rig_standard.json: THE player rig standard, taken from the skeleton the game already builds (FcBodyBuilder) for a neutral
## 198 cm, 95 kg small forward. Blender (tools/blender/build_player.py), the Godot player-model validator (FcPlayerModelValidator) and the documentation all
## read this one file, so a hand-made player and the generated one cannot drift apart from the game's own skeleton.
##   godot_console --headless --path . --script res://tools/export_rig_standard.gd
## Lengths are metres (the glTF unit), measured from the floor; the body faces +Z in the game (and -Y in Blender); the character's LEFT is +X.

const FEET_PER_METRE := 3.28084
const OUT := "res://data/player_pipeline/rig_standard.json"


func _initialize() -> void:
	var subject := {"key": "rig-standard", "name": "Standard", "jersey": 7, "position": "SF", "appearance": {"skin": "tone_3", "hair": "short", "facial_hair": "none"},
		"physical": {"height_cm": 198, "weight_kg": 95}, "team": {"primary": "#2F6FED", "secondary": "#F4F7FF", "abbreviation": "STD", "name": "Standard"}}
	var visual := FcPlayerVisual.resolve(subject)
	var archetype := FcBodyArchetype.make(visual)
	var builder := FcBodyBuilder.new()
	builder.build(archetype, visual["identity"], visual["uniform"])
	var bones: Array = []
	for i in FcBodyBuilder.BONES.size():
		var name: String = FcBodyBuilder.BONES[i]
		var at: Vector3 = builder.rest_origin(name) / FEET_PER_METRE
		bones.append({"name": name, "parent": str(FcBodyBuilder.PARENTS[i]), "rest": [snappedf(at.x, 0.0001), snappedf(at.y, 0.0001), snappedf(at.z, 0.0001)]})
	var dims := {}
	for key in ["wingspan", "leg_ratio", "head_h", "neck_r", "shoulder_x", "chest_rx", "chest_rz", "waist_rx", "waist_rz", "hip_rx", "hip_rz", "arm_r", "forearm_r", "thigh_r", "calf_r", "hand", "foot"]:
		dims[key] = snappedf(float(archetype[key]), 0.0001)
	var standard := {
		"standard_version": 1,
		"note": "Generated by tools/export_rig_standard.gd from FcBodyBuilder. Edit the builder, then regenerate; do not edit by hand.",
		"height_m": snappedf(float(archetype["height_feet"]) / FEET_PER_METRE, 0.0001),
		"facing": "+Z in the game and glTF, -Y in Blender; the character's left is +X",
		"bones": bones,
		"surfaces": Array(FcBodyBuilder.SURFACES),
		"hair_styles": ["short", "afro", "bald"],
		"rest_pose": "standing, arms hanging straight down beside the body, palms facing the thighs, feet flat and parallel (an A-pose is NOT used: FcBroadcastPose rotations assume this rest)",
		"proportions_as_fractions_of_height": dims,
		"limits": {"max_triangles": 20000, "min_height_m": 1.6, "max_height_m": 2.45, "weights_per_vertex": 4},
	}
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path("res://data/player_pipeline"))
	var file := FileAccess.open(OUT, FileAccess.WRITE)
	file.store_string(JSON.stringify(standard, "\t") + "\n")
	file.close()
	print("wrote ", OUT, " (", bones.size(), " bones, height ", standard["height_m"], " m)")
	quit()
